#!/usr/bin/env python3
"""A desktop notification as a card on the day bar, by its app's window.

Usage: notify-card <app> <icon> <desktop-entry> <summary> [<notification id>] < body

Called by the notification daemon (austraz.notifications) for every
notification it shows. The day bar finds the app's window and, if it is on
another desk, shows a card there: the summary (the sender, for a message) as
its title, the body under it. A long body goes through agent-summary, which
retells it in a sentence on the local model; a short one shows as it is.
"""
import html
import os
import re
import subprocess
import sys
import time
from pathlib import Path

TURN_DIR = Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp") / "spaces-agent" / "summary"
SUMMARY_BIN = Path(__file__).resolve().parent / "agent-summary"


def plain(text):
    """Notification bodies may carry markup: <b>, <a href>, entities."""
    text = re.sub(r"<br\s*/?>", "\n", str(text or ""), flags=re.I)
    text = re.sub(r"<[^>]+>", "", text)
    return html.unescape(text).strip()


def main():
    if len(sys.argv) < 5:
        return
    app, icon, desktop, summary = sys.argv[1:5]
    # The daemon's own id: the bar tells it back whether it made a card, so
    # the daemon keeps the notification off its ticker.
    notif = sys.argv[5] if len(sys.argv) > 5 else ""
    body = plain(sys.stdin.read())
    summary = plain(summary)
    if not summary and not body:
        if notif:
            subprocess.run(["omarchy-shell", "notifications", "carded", notif, "0"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
        return
    # One id per notification: the card's summary is keyed by it.
    msg_id = "notif-%d" % time.time_ns()
    subprocess.run(
        ["omarchy-shell", "austraz.daybar", "notify", msg_id, app, icon, desktop, summary, notif],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10,
    )
    if not body:
        return
    TURN_DIR.mkdir(parents=True, exist_ok=True)
    (TURN_DIR / msg_id).write_text(msg_id + "\n")
    try:
        subprocess.run([str(SUMMARY_BIN), msg_id, msg_id, "--text"], input=body, text=True,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=600)
    finally:
        (TURN_DIR / msg_id).unlink(missing_ok=True)


if __name__ == "__main__":
    main()
